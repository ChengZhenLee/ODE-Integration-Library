rule RERUN_CMAKE
  command = C:\Users\zhens\Downloads\w64devkit\bin\cmake.exe --regenerate-during-build -S"C:\Users\zhens\OneDrive\Desktop\ODE Integration Library" -B"C:\Users\zhens\OneDrive\Desktop\ODE Integration Library\build"
  description = Re-running CMake...
  generator = 1


